# systemic safety net for everything this narrow filter does not anticipate.
warnings.filterwarnings("ignore", message=r"Tight layout not applied.*", category=UserWarning)


def _locate_report_dir(anchor_filename, generation_time_path):
    """Locate this report's data directory, verifying against an anchor file.

    `Path(__file__)` is undefined when this notebook runs inside a Jupyter kernel: nbclient
    and Jupyter both start the kernel in the notebook's own directory instead, which makes
    `Path.cwd()` the correct fallback there. Each candidate is verified against a file that
    must exist rather than trusted blindly, and the generation-time absolute path is the
    last-resort fallback for a notebook opened with a stray working directory.
    """
    candidates = []
    try:
        candidates.append(Path(__file__).parent.resolve())
    except NameError:
        pass
    candidates.append(Path.cwd())
    candidates.append(Path(generation_time_path))

    for candidate in candidates:
        if (candidate / anchor_filename).exists():
            return candidate

    raise FileNotFoundError(
        f"could not locate the report's data directory: no candidate among {candidates} "
        f"contains {anchor_filename!r}"
    )

