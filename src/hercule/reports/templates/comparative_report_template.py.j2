# %% [markdown]
# ## Hyperparameter Impact
#
# **How much of the performance variance does each hyperparameter -- and each pairwise
# combination -- actually account for?** This section is a variance decomposition (ANOVA /
# eta-squared by grouping), attributing the variance of the performance metric to each
# hyperparameter and to each pair of hyperparameters.
#
# 1. **Variance decomposition** -- one consolidated table: every main effect AND every pure
#    two-way interaction, named individually, sorted by descending share, plus a residual row
#    (three-way-and-higher interaction terms plus noise -- the design is saturated, so the two
#    cannot be told apart from this data alone; see the replication warning below). No p-value is
#    computed anywhere: a saturated design has zero residual degrees of freedom, which makes one
#    meaningless.
# 2. **Main effects, mean AND max** -- the mean alone is misleading for optimisation: a
#    hyperparameter can have a flat mean across levels (mean says "irrelevant") while its maximum
#    attainable performance strictly decreases (max says "this sets your ceiling") -- and the
#    level ranking can flip between the two. Both series are plotted; the text flags every
#    hyperparameter where they disagree on which level is best.
# 3. **Full grid vs top decile** -- the SAME main-effects decomposition, rerun on only the
#    best-scoring ~10% of runs. "Important on average" is not "important where the good
#    configurations are": a hyperparameter's rank can invert between the two columns, and if the
#    goal is to optimise rather than describe average behaviour, the top-decile column is the
#    relevant one.
# 4. **Interaction heatmap** -- mean performance for every combination of the two hyperparameters
#    with the strongest *pure* two-way interaction (not simply the two most important on their
#    own), annotated with cell means and run counts.
#
# A family is reported as "not applicable" with a stated reason, never an exception, when it has
# too few runs, no varying numeric hyperparameter, or constant performance. Where the design has
# no replication (no repeated seeds per configuration), a warning precedes the four views: the
# residual share can then not be separated from run-to-run noise.

# %% tags=["{{ tag_remove_input }}"]
def _format_level(value):
    """Print an integral-valued level (e.g. batch_size 32.0) without a trailing '.0'."""
    return f"{value:g}"


def _format_pct_or_dropped(value):
    """Print an eta-squared share as a percentage, or note its absence (dropped in the subset)."""
    return f"{value:.1%}" if value is not None else "n/a (dropped in this subset)"


for family_name, family_records in run_table.by_model_family().items():
    print(f"\n### {family_name}")

    replication = replication_status(family_records)
    if not replication.has_replication:
        print(f"WARNING -- {replication.reason}")

    # --- [1] Consolidated variance decomposition ------------------------------------------
    decomposition = variance_decomposition(family_records)
    if isinstance(decomposition, VarianceDecompositionUnavailable):
        print(f"\nVariance decomposition not applicable: {decomposition.reason}")
    else:
        bar_names = [entry.name for entry in decomposition.entries] + ["residual (not separable)"]
        bar_values = [entry.eta_squared for entry in decomposition.entries] + [decomposition.residual_eta_squared]
        bar_colors = [
            "tab:blue" if entry.kind == "main_effect" else "tab:orange" for entry in decomposition.entries
        ] + ["tab:red"]

        fig, ax = plt.subplots(figsize=(max(8, 0.6 * len(bar_names)), 5))
        bars = ax.bar(bar_names, bar_values, color=bar_colors, alpha=0.85)
        for bar, value in zip(bars, bar_values):
            ax.annotate(
                f"{value:.1%}",
                (bar.get_x() + bar.get_width() / 2, bar.get_height()),
                ha="center",
                va="bottom",
                fontsize=7,
            )
        ax.set_ylabel("share of performance variance (eta-squared)")
        ax.set_title(f"{family_name}: variance decomposition ({decomposition.n_samples} runs)")
        ax.tick_params(axis="x", rotation=60, labelsize=7)
        for tick_label in ax.get_xticklabels():
            tick_label.set_ha("right")
        ax.grid(True, alpha=0.3, axis="y")
        plt.tight_layout()
        plt.show()

        print(
            "\nVariance decomposition (eta-squared, exact for a balanced design; stops at "
            "two-way order -- no p-value: a saturated design has zero residual degrees of "
            "freedom, which makes one meaningless):"
        )
        for entry in decomposition.entries:
            kind_label = "main effect" if entry.kind == "main_effect" else "interaction"
            print(f"  - {entry.name} ({kind_label}): {entry.eta_squared:.1%}")
        print(f"  Main effects sum: {decomposition.main_effects_sum:.1%}")
        print(f"  Pure 2-way interactions sum: {decomposition.interaction_sum:.1%}")
        print(
            f"  Residual (3-way-and-higher interactions + noise, not separable on this design): "
            f"{decomposition.residual_eta_squared:.1%}"
        )
        if decomposition.dropped_columns:
            print("\nExcluded from this analysis:")
            for excluded_name, excluded_reason in decomposition.dropped_columns.items():
                print(f"  - {excluded_name}: {excluded_reason}")

    # --- [2] Main effects, mean AND max ----------------------------------------------------
    # Small multiples: ONE panel per hyperparameter, rather than overlaying every hyperparameter
    # on a shared "level index" axis. A shared index axis has no common meaning across
    # hyperparameters (level 0 is batch_size=32 on one line and learning_rate=0.0001 on
    # another), so the lines crossed at points that meant nothing, and value-point annotations
    # for five overlaid lines collided into unreadable mush (e.g. "5000" and "10000" printed on
    # top of each other). Each panel's x-axis instead uses that hyperparameter's own levels as
    # categorical ticks labelled with the real values -- no annotations needed, no collisions.
    main_effects = hyperparameter_main_effects(family_records)
    if isinstance(main_effects, MainEffectsUnavailable):
        print(f"\nMain effects not applicable: {main_effects.reason}")
    else:
        plottable = [hp for hp in main_effects.hyperparameters if len(hp.levels) >= 2]

        # Reuses the eta-squared shares already computed for view [1] instead of recomputing
        # hyperparameter_importance() a second time.
        main_effect_eta_by_name = {}
        if isinstance(decomposition, VarianceDecompositionResult):
            main_effect_eta_by_name = {
                entry.name: entry.eta_squared for entry in decomposition.entries if entry.kind == "main_effect"
            }

        if plottable:
            ncols = min(3, len(plottable))
            nrows = int(np.ceil(len(plottable) / ncols))
            fig, axes = plt.subplots(nrows, ncols, figsize=(5.2 * ncols, 4.2 * nrows), squeeze=False)
            flat_axes = axes.flatten()

            for ax, hp in zip(flat_axes, plottable):
                x_positions = np.arange(len(hp.levels))
                level_labels = [_format_level(level.level) for level in hp.levels]
                means = [level.mean_performance for level in hp.levels]
                ax.plot(x_positions, means, marker="o", color="tab:blue", linewidth=2, label="mean")

                if hp.max_is_saturated:
                    # Defects 3/4: the max is (near-)constant relative to its own scale (e.g.
                    # 499.69-500.00 on CartPole, a 0.06% spread) -- plotting it as its own line
                    # would let matplotlib autoscale that noise into a dramatic-looking curve.
                    # A flat reference line sharing the mean's own y-axis makes the saturation
                    # visually obvious instead: it sits near the top, clearly flat, while the
                    # mean's real variation still has room to be seen.
                    ceiling = max(level.max_performance for level in hp.levels)
                    ax.axhline(
                        ceiling,
                        color="tab:orange",
                        linestyle=":",
                        linewidth=1.5,
                        alpha=0.7,
                        label=f"max (saturated ~{ceiling:g})",
                    )
                else:
                    maxima = [level.max_performance for level in hp.levels]
                    ax.plot(x_positions, maxima, marker="^", linestyle="--", color="tab:orange", linewidth=2, label="max")

                ax.set_xticks(x_positions)
                ax.set_xticklabels(level_labels, fontsize=8)
                title = hp.name
                if hp.name in main_effect_eta_by_name:
                    title += f" (eta^2={main_effect_eta_by_name[hp.name]:.1%})"
                ax.set_title(title, fontsize=10, fontweight="bold")
                ax.set_ylabel("performance")
                ax.legend(loc="best", fontsize=7)
                ax.grid(True, alpha=0.3)

            for ax in flat_axes[len(plottable) :]:
                ax.axis("off")

            fig.suptitle(f"{family_name}: main effects, mean and max per level", fontsize=13, fontweight="bold")
            plt.tight_layout(rect=(0.0, 0.0, 1.0, 0.94))
            plt.show()

        print(
            "\nCaveat: a linear correlation can understate or entirely miss a non-monotonic "
            "effect (e.g. a hyperparameter whose best value sits at a middle level rather than "
            "an endpoint) -- these plots, not a correlation, are the authority on shape."
        )

        # Defect 4: max-attainable is meaningless once the environment's ceiling is reached
        # almost everywhere (CartPole caps every episode at 500 steps) -- state that explicitly
        # instead of letting a flat, autoscaled max line imply a real effect.
        if plottable and main_effects.all_max_saturated:
            ceiling = max(level.max_performance for hp in plottable for level in hp.levels)
            print(
                f"\nMax-performance view: saturated at ~{ceiling:g} for every level of every hyperparameter in "
                f"this family -- this environment's ceiling is reached almost everywhere, so the max view "
                f"carries no signal here; only the mean panels above should be read."
            )
        else:
            saturated_hps = [hp for hp in plottable if hp.max_is_saturated]
            if saturated_hps:
                ceiling = max(level.max_performance for hp in saturated_hps for level in hp.levels)
                saturated_names = ", ".join(hp.name for hp in saturated_hps)
                print(
                    f"\nMax-performance view: saturated at ~{ceiling:g} for {saturated_names} -- shown as a flat "
                    f"ceiling reference rather than a line, since it carries no signal there; read the mean only "
                    f"for those hyperparameters."
                )

        divergences = [hp for hp in main_effects.hyperparameters if hp.mean_and_max_disagree]
        if divergences:
            print(
                "\nMean-vs-max divergence: the mean alone is misleading for optimisation -- the "
                "best level by MEAN and the best level by MAX (your ceiling) disagree for:"
            )
            for hp in divergences:
                print(
                    f"  - {hp.name}: best by mean = {_format_level(hp.best_level_by_mean)}, "
                    f"best by max = {_format_level(hp.best_level_by_max)}"
                )

    # --- [3] Full grid vs top decile --------------------------------------------------------
    top_decile = top_decile_comparison(family_records)
    if isinstance(top_decile, TopDecileComparisonUnavailable):
        print(f"\nFull-grid-vs-top-decile comparison not applicable: {top_decile.reason}")
    else:
        full_by_name = {entry.name: entry.eta_squared for entry in top_decile.full_main_effects}
        top_by_name = {entry.name: entry.eta_squared for entry in top_decile.top_decile_main_effects}
        ordered_names = [entry.name for entry in top_decile.full_main_effects]

        x_positions = np.arange(len(ordered_names))
        bar_width = 0.35
        fig, ax = plt.subplots(figsize=(max(8, 0.9 * len(ordered_names)), 5))
        ax.bar(x_positions - bar_width / 2, [full_by_name[name] for name in ordered_names], bar_width,
               label=f"full grid (n={top_decile.n_full})", color="tab:blue")
        ax.bar(x_positions + bar_width / 2, [top_by_name.get(name, 0.0) for name in ordered_names], bar_width,
               label=f"top decile (n={top_decile.n_top_decile})", color="tab:green")
        ax.set_xticks(list(x_positions))
        ax.set_xticklabels(ordered_names, rotation=45, ha="right", fontsize=8)
        ax.set_ylabel("share of performance variance (eta-squared)")
        ax.set_title(
            f"{family_name}: full grid vs top decile (score >= {top_decile.threshold:g})"
        )
        ax.legend(loc="best", fontsize=8)
        ax.grid(True, alpha=0.3, axis="y")
        plt.tight_layout()
        plt.show()

        print(
            f"\nFull grid (n={top_decile.n_full}) vs top decile (score >= {top_decile.threshold:g}, "
            f"n={top_decile.n_top_decile}) main effects, side by side:"
        )
        for name in ordered_names:
            print(f"  - {name}: full {full_by_name[name]:.1%} -> top decile {_format_pct_or_dropped(top_by_name.get(name))}")

        if top_decile.rank_shifts:
            print("\nRank shifts (full-grid rank -> top-decile rank; biggest movers first, no magnitude cutoff):")
            for shift in top_decile.rank_shifts:
                print(f"  - {shift.name}: rank {shift.rank_full} -> rank {shift.rank_top_decile} (shift {shift.shift:+d})")
        print(
            "\nLesson: 'important on average' (full grid) is not 'important where the good "
            "configurations are' (top decile) -- if the goal is to optimise rather than describe "
            "average behaviour, the top-decile column above is the relevant one."
        )

    # --- [4] Interaction ranking + heatmap ----------------------------------------------
    ranking = interaction_ranking(family_records)
    if isinstance(ranking, InteractionRankingUnavailable):
        print(f"\nInteraction ranking not applicable: {ranking.reason}")
    else:
        # Full detail (both main effects, cell share) for every pair is redundant with the
        # heatmap below, which already names and details the top pair -- only the top 3 pairs
        # by pure interaction share are listed here, to justify why that pair was chosen.
        print("\nTop pairwise interactions (pure 2-way share; the heatmap below details the top pair):")
        for pair in ranking.pairs[:3]:
            print(f"  - {pair.first} x {pair.second}: {pair.interaction_eta_squared:.1%}")

    grid = interaction_grid(family_records)
    if isinstance(grid, InteractionGridUnavailable):
        print(f"Interaction heatmap not applicable: {grid.reason}")
    else:
        by_cell = {(cell.first_level, cell.second_level): cell for cell in grid.cells}
        matrix = np.full((len(grid.first_levels), len(grid.second_levels)), np.nan)
        for i, level_a in enumerate(grid.first_levels):
            for j, level_b in enumerate(grid.second_levels):
                mean_value = by_cell[(level_a, level_b)].mean_performance
                if mean_value is not None:
                    matrix[i, j] = mean_value

        finite_matrix = matrix[np.isfinite(matrix)]
        has_spread = finite_matrix.size > 0 and np.ptp(finite_matrix) > 0

        fig, ax = plt.subplots(figsize=(6.5, 5.5))
        if has_spread:
            image = ax.imshow(matrix, cmap="viridis", aspect="auto")
            fig.colorbar(image, ax=ax, label="mean performance")
        else:
            # A constant (or all-empty) grid would make matplotlib autoscale clim to a single
            # value and render fabricated colorbar ticks for a range that does not exist
            # (research R5) -- draw a neutral grid with no colorbar instead.
            ax.imshow(np.nan_to_num(matrix, nan=0.0), cmap="Greys", vmin=0, vmax=1, aspect="auto")

        for i, level_a in enumerate(grid.first_levels):
            for j, level_b in enumerate(grid.second_levels):
                cell = by_cell[(level_a, level_b)]
                text = f"{cell.mean_performance:.3f}\n(n={cell.n_runs})" if cell.mean_performance is not None else "n/a"
                ax.text(j, i, text, ha="center", va="center", fontsize=8, color="white" if has_spread else "black")

        ax.set_xticks(range(len(grid.second_levels)))
        ax.set_xticklabels([_format_level(v) for v in grid.second_levels])
        ax.set_yticks(range(len(grid.first_levels)))
        ax.set_yticklabels([_format_level(v) for v in grid.first_levels])
        ax.set_xlabel(grid.second)
        ax.set_ylabel(grid.first)
        ax.set_title(
            f"{family_name}: {grid.first} x {grid.second} interaction "
            f"({grid.interaction_eta_squared:.1%} pure interaction)"
        )
        plt.tight_layout()
        plt.show()

        print(
            f"\n{grid.first} x {grid.second}: pure interaction {grid.interaction_eta_squared:.1%}, main effects "
            f"{grid.first}={grid.first_eta_squared:.1%} / {grid.second}={grid.second_eta_squared:.1%} "
            f"(joint cell explains {grid.cell_eta_squared:.1%} together)."
        )

# %% [markdown]
# ## Performance Metrics
#
# The top 3 runs by performance (testing-phase mean reward, falling back to the learning-phase
# mean when a run has no testing phase) across every model family in this comparison.
# Hyperparameters are shown restricted to each run's own varying ones, importance-ranked, and
# are guaranteed pairwise distinct across the rows shown -- two different runs never render an
# identical hyperparameters cell. A metric column is shown only when it is not an exact
# duplicate of `performance` or of another column already shown, and either it (or, if every
# ranked run shares one model family, the per-row model column) may be dropped to keep the table
# within a printable page width (see below). Each run's full, exact path is listed below the
# table.

# %% tags=["{{ tag_remove_input }}"]
ranked_runs = rank_runs_by_performance(run_table.records, top_n=3)

# A monospace PDF page's printable width is roughly 88 characters (measured); the previous
# 20-character hyperparameters cap could truncate away the one parameter distinguishing two
# ranked runs, rendering them identically. This spends the ~19 characters of spare width between
# the table's previous line length (69) and that budget on the hyperparameters column instead.
_TOP_TABLE_PRINTABLE_WIDTH = 88

if not ranked_runs:
    print("No run produced a usable performance value; nothing to rank or declare a winner over.")
else:
    ranked_records = [ranked.record for ranked in ranked_runs]
    names_for_table = [varying_names_by_family.get(record.model_name, varying_names) for record in ranked_records]
    model_is_constant = len({record.model_name for record in ranked_records}) == 1

    def _format_metric(value):
        return f"{value:.4f}" if value is not None else "n/a"

    def _hyperparameter_text(record):
        family_names = varying_names_by_family.get(record.model_name, varying_names)
        return format_varying_hyperparameters(record, family_names, max_length=40)

    extra_metric_columns = select_top_table_metric_columns(ranked_records)

    def _build_top_table(metric_columns, *, include_model_column):
        # `format_top_table_hyperparameter_cells` guarantees the returned cells are pairwise
        # distinct across `ranked_records` (defect: a length cap truncating away the one
        # hyperparameter that told two ranked runs apart) -- it shares its collision-resolution
        # logic with the chart legends' `format_series_labels` rather than reimplementing it.
        hyperparameter_cells = format_top_table_hyperparameter_cells(ranked_records, names_for_table)
        rows = []
        for index, ranked in enumerate(ranked_runs):
            row = {"rank": ranked.rank}
            if include_model_column:
                row["model"] = ranked.record.model_name
            row["hyperparameters"] = hyperparameter_cells[index]
            row["performance"] = _format_metric(ranked.record.performance)
            row.update({column: _format_metric(getattr(ranked.record, column)) for column in metric_columns})
            rows.append(row)
        # Short headers (TOP_TABLE_COLUMN_LABELS) for the metric columns only -- the full
        # attribute names (e.g. "testing_success_rate") are used everywhere else in this report,
        # but three of them side by side already push a monospace table past a typical PDF
        # page's printable width.
        return pd.DataFrame(rows).rename(columns=TOP_TABLE_COLUMN_LABELS).to_string(index=False)

    def _max_line_width(text):
        return max((len(line) for line in text.splitlines()), default=0)

    include_model_column = True
    top_table_text = _build_top_table(extra_metric_columns, include_model_column=include_model_column)
    max_line_width = _max_line_width(top_table_text)

    # A monospace PDF page's printable width is roughly 88 characters (measured); guaranteeing
    # pairwise-distinct hyperparameters cells (format_top_table_hyperparameter_cells) can widen a
    # row past that when a collision needs its uncapped, or even run-name-suffixed, form. An
    # ambiguous table is worse than a table with fewer columns, so width is freed by dropping
    # columns rather than letting a row wrap mid-line: first the least informative metric
    # column(s) (`extra_metric_columns` is already ordered from most to least informative by
    # `select_top_table_metric_columns`), then -- if every ranked run happens to share the same
    # model family, so the per-row "model" column repeats one value three times and carries zero
    # information -- that column too, stating the shared family once in prose instead.
    while max_line_width > _TOP_TABLE_PRINTABLE_WIDTH and extra_metric_columns:
        extra_metric_columns = extra_metric_columns[:-1]
        top_table_text = _build_top_table(extra_metric_columns, include_model_column=include_model_column)
        max_line_width = _max_line_width(top_table_text)

    if max_line_width > _TOP_TABLE_PRINTABLE_WIDTH and model_is_constant:
        include_model_column = False
        top_table_text = _build_top_table(extra_metric_columns, include_model_column=include_model_column)
        max_line_width = _max_line_width(top_table_text)

    if not include_model_column:
        print(f"All {len(ranked_runs)} run(s) below are model family '{ranked_records[0].model_name}'.\n")
    print(top_table_text)

    print("\nFull path of each run above, relative to this report's own directory:")
    for ranked in ranked_runs:
        print(f"{ranked.rank}. {format_relative_run_path(ranked.record, report_dir)}")

    winner = ranked_runs[0].record
    print(f"\nWinner: {winner.model_name} ({_hyperparameter_text(winner)}), performance {winner.performance:.4f}.")
    if len(ranked_runs) > 1:
        runner_up = ranked_runs[1].record
        margin = winner.performance - runner_up.performance
        print(f"Outperforms the runner-up ({runner_up.model_name}, {_hyperparameter_text(runner_up)}) by {margin:.4f}.")

